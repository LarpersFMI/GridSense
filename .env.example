# Copy to .env at the repository root. Read by the TypeScript packages (server, watchdog) and by the Python pipeline.
DATABASE_URL=postgres://gridsense:gridsense@localhost:5432/gridsense
REDIS_URL=redis://localhost:6379
PORT=4000
# Where the Watchdog and the Python reporting (gridsense.report_dataset_updated) reach the server.
GRIDSENSE_SERVER_URL=http://localhost:4000
WATCHDOG_PORT=4100
PIPELINE_RUNNER_PORT=4200
# How the PipelineRunner runs the repository's Python (gridsense.pipelines).
PIPELINE_PYTHON=uv run python
# Where the Python pipeline writes its parquet files (Dataset.*.FILE), relative to the repository root.
DATASET_DIR=data/processed
LOG_LEVEL=info
# Python pipeline (src/gridsense): optional ENTSO-E token.
ENTSOE_API_TOKEN=
# Transparency Platform email and password, used by gridsense.data.entsoe_files (File Library).
ENTSOE_USER=
ENTSOE_PASSWORD=
# Optional: only used for notification/report wording; templates are the fallback.
LLM_API_KEY=
