{
    "name": "@gridsense/frontend",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "The admin's UI: triggers (list, editor) and live activity (runs, checks, hits). React + Vite, Blueprint, Tailwind; Quarry's SDK pattern.",
