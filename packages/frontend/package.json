        "@tanstack/router-plugin": "^1.168.48",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "tailwindcss": "^4.3.5"
    },
    "dependencies": {
        "@blueprintjs/core": "^6.22.0",
        "@blueprintjs/icons": "^6.15.0",
        "@blueprintjs/table": "^6.3.1",
        "@hookform/resolvers": "^7.0.3",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "immer": "^11.2.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
